# Spazio — environment variables
# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real secrets.

# --- Square (paid Brand Gap Audit) ---
# Access token for your Square app (sandbox or production). Server-side only.
SQUARE_ACCESS_TOKEN=

# Square location ID the payment is attributed to (e.g. L1234ABCD).
SQUARE_LOCATION_ID=

# "production" or "sandbox" — selects the Square API host.
SQUARE_ENVIRONMENT=sandbox

# Catalog ITEM VARIATION id for the Brand Audit (the order line item references
# the variation, not the parent item). See README/PR notes for how to look it up.
SQUARE_CATALOG_ITEM_ID=

# Webhook signature key for /api/square-webhook (Square Dashboard → Webhooks).
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Comp / bypass (free test-run access) ---
# Secret code that lets a specific person skip Square Checkout: visiting
# /api/checkout?access=<this value> drops them straight into the Foundation form.
# Verified server-side in /api/checkout and /api/verify-session. Leave unset to
# disable the bypass entirely (no code = no free path).
AUDIT_COMP_CODE=

# --- Scheduling ("Book a call" + "Book a 15-min intro") ---
# Full scheduling URL (Calendly or Cal.com), e.g. https://calendly.com/spazio/brand-audit
# Injected server-side; embedded inline on the confirmation step and linked from the intro CTAs.
SCHEDULER_URL=

# --- Airtable (already required by existing routes) ---
# Personal access token with write scope to the SpazioOS base (appv2sIRwDvNPjV7j).
# Used by /api/foundation and /api/square-webhook to upsert Leads.
AIRTABLE_TOKEN=
